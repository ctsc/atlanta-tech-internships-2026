# Google Gemini API (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# GitHub Personal Access Token (for issue processing) — https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here

# Morning digest (Resend) — https://resend.com
RESEND_API_KEY=your-resend-api-key-here
DIGEST_TO_EMAIL=you@example.com
RESEND_FROM_EMAIL=onboarding@resend.dev
